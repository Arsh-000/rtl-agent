# Basic SDC generated by rtl-agent - REVIEW IT before trusting timing results.
# Clock period 0.5 ns; I/O delays are 10% of the period.
create_clock -name clk -period 0.5 [get_ports clk]
set_input_delay 0.05 -clock clk [get_ports {rst bit_in bit_valid}]
set_output_delay 0.05 -clock clk [all_outputs]
