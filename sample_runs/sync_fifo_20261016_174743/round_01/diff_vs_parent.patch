--- round_00/sync_fifo.v
+++ round_01/sync_fifo.v
@@ -1,16 +1,10 @@
-// sync_fifo: 16-entry x 8-bit synchronous FIFO built from flip-flops.
-//
-// The storage is a register array (mem). Write and read pointers walk
-// through it. An occupancy counter drives the registered full/empty flags.
-// The output dout is read straight from the array through a 16-to-1
-// multiplexer selected by the read pointer.
 module sync_fifo (
     input  wire       clk,
-    input  wire       rst_n,     // active-low asynchronous reset
+    input  wire       rst_n,
     input  wire       wr_en,
     input  wire [7:0] din,
     input  wire       rd_en,
-    output wire [7:0] dout,      // data at the head of the FIFO (valid when !empty)
+    output wire [7:0] dout,
     output reg        full,
     output reg        empty
 );
@@ -21,12 +15,18 @@
     wire do_wr = wr_en && !full;
     wire do_rd = rd_en && !empty;
 
+    // write the free slot every cycle; it only becomes visible once wr_ptr moves past it
+    wire wr_slot = !full;
     always @(posedge clk) begin
-        if (do_wr)
+        if (wr_slot)
             mem[wr_ptr] <= din;
     end
 
-    assign dout = mem[rd_ptr];
+    // Look-ahead head register: compute NEXT cycle's head-of-queue value now, so the 16-to-1 read
+    // multiplexer is no longer on the path to the dout port.
+    // Next head = the slot the read pointer will point to, or din if that slot is being written now.
+    wire [3:0] rd_ptr_next = rd_ptr + {3'd0, do_rd};
+    wire [7:0] head_next   = (wr_slot && wr_ptr == rd_ptr_next) ? din : mem[rd_ptr_next];
 
     always @(posedge clk or negedge rst_n) begin
         if (!rst_n) begin
@@ -37,7 +37,7 @@
             empty  <= 1'b1;
         end else begin
             if (do_wr) wr_ptr <= wr_ptr + 4'd1;
-            if (do_rd) rd_ptr <= rd_ptr + 4'd1;
+            if (do_rd) rd_ptr <= rd_ptr_next;
             case ({do_wr, do_rd})
                 2'b10: begin
                     count <= count + 5'd1;
@@ -49,8 +49,15 @@
                     full  <= 1'b0;
                     empty <= (count == 5'd1);
                 end
-                default: ;   // no change, or a write and a read in the same cycle
+                default: ;
             endcase
         end
     end
+
+    reg [7:0] head;
+    always @(posedge clk)
+        head <= head_next;
+    // The original's reset is asynchronous: it moves the read pointer to slot 0 at once, so its
+    // output shows mem[0] immediately. Copy that exactly while reset is active.
+    assign dout = rst_n ? head : mem[0];
 endmodule
